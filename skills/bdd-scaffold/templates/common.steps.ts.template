import { expect } from '@playwright/test';
import { createBdd } from 'playwright-bdd';

const { Given, When, Then } = createBdd();

Given('the application is running', async ({ page }) => {
  // Adjust to your app's entry point; baseURL comes from playwright.config.ts.
  await page.goto('/');
});

Given('a visitor opens the home page', async ({ page }) => {
  await page.goto('/');
});

When('the page finishes loading', async ({ page }) => {
  await page.waitForLoadState('networkidle');
});

Then('a welcome message is shown', async ({ page }) => {
  await expect(page.getByRole('heading')).toBeVisible();
});
